# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://devuser:mypassword@localhost:5432/health?schema=public"

# Authentication & Security
# Required: 32 random bytes, base64url encoded. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_RATE_LIMIT_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800

# Optional comma-separated proxy IPs. Forwarded headers are ignored by default.
TRUSTED_PROXY_IPS=

# Required only when the seed needs to create the initial administrator.
INITIAL_ADMIN_PASSWORD=
