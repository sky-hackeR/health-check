DATABASE_URL="postgresql://goswift_admin:goswift_dev_pass_2026@localhost:5432/goswifthr_intelligence?schema=public"

# Auth & Secrets (Override with cryptographically secure values in production)
JWT_SECRET=goswift_dev_jwt_secret_key_change_in_production_32chars
