# Backend Service
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001/api/v1
NODE_ENV=development

# Frontend Service
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Infrastructure
